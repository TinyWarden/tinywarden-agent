{
  "type": "object",
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 0,
      "maxLength": 64,
      "enum": [
        "none",
        "package_output_unavailable"
      ]
    },
    "mode": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32,
      "enum": [
        "upgrade",
        "with-new-pkgs"
      ]
    },
    "upgraded": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "installed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "removed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "held_back": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "index_freshness": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32,
      "enum": [
        "unverified"
      ]
    },
    "state_consistency": {
      "type": "string",
      "minLength": 0,
      "maxLength": 32,
      "enum": [
        "unverified"
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          "installed_version": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          "available_version": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128
          },
          "action": {
            "type": "string",
            "minLength": 0,
            "maxLength": 128,
            "enum": [
              "upgraded",
              "installed",
              "removed",
              "held_back"
            ]
          }
        },
        "required": [
          "package",
          "installed_version",
          "available_version",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "package_list_complete": {
      "type": "boolean"
    },
    "package_list_truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "problem"
  ],
  "additionalProperties": false
}
