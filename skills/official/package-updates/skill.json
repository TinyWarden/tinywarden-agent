{
  "format": 1,
  "id": "tinywarden/package-updates",
  "alias": "package-updates",
  "version": "1.1.5",
  "runtime": "python-3.13-v1",
  "sdk": 1,
  "state_version": 1,
  "license": "Apache-2.0",
  "publisher": "TinyWarden",
  "name_key": "name",
  "description_key": "description",
  "category": "Packages",
  "compatibility": {
    "os": [
      "debian:13"
    ],
    "architectures": [
      "amd64"
    ]
  },
  "defaults": {
    "interval_seconds": 3600,
    "timeout_seconds": 30,
    "package_mode": "upgrade"
  },
  "schedule": {
    "minimum_seconds": 60,
    "maximum_seconds": 86400
  },
  "capabilities": [
    {
      "operation": "command.capture",
      "executable": "/usr/bin/apt-get",
      "argv": [
        [
          "--simulate",
          "upgrade"
        ],
        [
          "--simulate",
          "--with-new-pkgs",
          "upgrade"
        ]
      ],
      "inputs": [
        "/etc/apt/sources.list",
        "/etc/apt/sources.list.d",
        "/etc/apt/preferences",
        "/etc/apt/preferences.d",
        "/var/lib/apt/lists",
        "/var/lib/apt/extended_states",
        "/var/lib/dpkg/status",
        "/usr/share/dpkg",
        "/etc/apt/mirrors"
      ],
      "timeout_seconds": 30,
      "helpers": [
        "/usr/bin/dpkg",
        "/usr/lib/apt/methods/mirror+file",
        "/usr/lib/apt/methods/file",
        "/usr/lib/apt/methods/http",
        "/usr/lib/apt/methods/https"
      ],
      "empty_directories": [
        "/etc/apt/apt.conf.d"
      ]
    }
  ],
  "limits": {
    "wall_seconds": 60
  },
  "fields": {
    "interval_seconds": {
      "label_key": "interval_label",
      "help_key": "interval_help",
      "unit": "seconds",
      "order": 0
    },
    "timeout_seconds": {
      "label_key": "timeout_label",
      "help_key": "timeout_help",
      "unit": "seconds",
      "order": 1
    },
    "package_mode": {
      "label_key": "package_mode_label",
      "help_key": "package_mode_help",
      "unit": "",
      "order": 2
    }
  }
}
