[Unit]
Description=TinyWarden maintenance request polling
After=network-online.target
Wants=network-online.target
RequiresMountsFor="@BASE@"

[Service]
Type=oneshot
User=root
ExecStart="@BASE@/current/tinywarden-agent" maintenance --config "@BASE@/config.json" --poll
UMask=0077
TimeoutStartSec=90s
NoNewPrivileges=true
PrivateTmp=true
Delegate=cpu memory pids
DelegateSubgroup=supervisor
