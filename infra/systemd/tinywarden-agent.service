[Unit]
Description=TinyWarden host agent
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=tinywarden-agent
Group=tinywarden-agent
WorkingDirectory=/var/lib/tinywarden-agent
ExecStart=/usr/bin/env /usr/local/bin/tinywarden-agent run --config /etc/tinywarden-agent/agent.json
# The agent handles transient outages itself; terminal authority/configuration errors stop it.
Restart=on-abnormal
UMask=0077
NoNewPrivileges=true
Delegate=cpu memory pids
DelegateSubgroup=supervisor
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
